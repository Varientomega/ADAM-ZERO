# ADAM-ZERO Configuration

# Anthropic API key (required)
ANTHROPIC_API_KEY=your_key_here

# Claude model to use (optional, defaults to claude-sonnet-4-6)
ADAM_MODEL=claude-sonnet-4-6

# TheVoid directory (optional, defaults to ~/TheVoid)
THE_VOID_PATH=~/TheVoid

# Browser settings
HEADLESS=true
BROWSER_TIMEOUT=30000

# Platform credentials (for LLM thread extraction)
# Stored credentials are used only for session auth — never logged
CLAUDE_AI_SESSION=
CHATGPT_SESSION=
GEMINI_SESSION=
